# Configuración exacta usada en la prueba exitosa (08/10/2026).
# Para usarla:  copy .env.probado .env

CHEQUES_INPUT_DIR=../cheques_entrada
APP_HOST=127.0.0.1
APP_PORT=8000
POLL_SECONDS=2
MAX_IMAGE_WIDTH=2000
MIN_IMAGE_WIDTH=1400
LOW_CONFIDENCE=0.80

# TrOCR desactivado (en la prueba solo se usó el OCR)
HANDWRITING_ENABLED=false
HANDWRITING_MODEL=microsoft/trocr-base-handwritten

# Ollama desactivado
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
VLM_MODE=fallback

CORS_ORIGINS=*
