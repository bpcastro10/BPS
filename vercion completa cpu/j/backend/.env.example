# Copie este archivo como .env para cambiar la configuración.

# Carpeta que se vigila (cada archivo nuevo se procesa automáticamente)
CHEQUES_INPUT_DIR=../cheques_entrada

APP_HOST=127.0.0.1
APP_PORT=8000

# Cada cuántos segundos se revisa la carpeta
POLL_SECONDS=2

# Confianza mínima (0..1) bajo la cual se intenta refinar un campo
LOW_CONFIDENCE=0.80

# Reconocimiento de manuscritos con TrOCR (requiere requirements-manuscritos.txt)
HANDWRITING_ENABLED=true
HANDWRITING_MODEL=microsoft/trocr-base-handwritten

# Opcional: modelo de visión local con Ollama (ej. qwen2.5vl:7b). Vacío = desactivado.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=
# fallback = solo cuando el cheque queda "REVISAR"; always = siempre; off = nunca
VLM_MODE=fallback
